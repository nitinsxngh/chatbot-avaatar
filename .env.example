OPENAI_API_KEY=your_openai_api_key_here

# Pinecone (vector DB)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=chatbot-avatar
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# MongoDB (chat memory + durable turn logs)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=chatbot_avatar
MONGODB_COLLECTION=chat_memory
MONGODB_LOGS_COLLECTION=chat_logs

# Optional: separate chat sessions
CHAT_SESSION_ID=default

# Assistant identity (change to reuse for other assistants)
ASSISTANT_NAME=Digital Marketing Assistant
ASSISTANT_ROLE=digital marketing
ASSISTANT_ORGANISATION=Chatbot Avatar

# Optional LangSmith tracing (dev debugging)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=chatbot-avatar
